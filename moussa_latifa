</div>

<div id="intro">
<svg width="0" height="0" style="position:absolute"><defs>
<g id="fp" fill="none" stroke-width="1.4" stroke-linecap="round"><path id="pt" d="M0 0C-14-10-14-34 0-40C14-34 14-10 0 0Z"/><use href="#pt" transform="rotate(72)"/><use href="#pt" transform="rotate(144)"/><use href="#pt" transform="rotate(216)"/><use href="#pt" transform="rotate(288)"/><circle r="5"/><path d="M0 0C6 50 30 80 64 110M18 52c16-6 30 2 36 16-16 6-30-2-36-16zM40 84c14-10 28-6 36 6-14 8-28 4-36-6z"/></g>
<g id="fw"><use href="#fp" stroke="#12203a" stroke-opacity=".3" transform="translate(1.6 1.6)"/><use href="#fp" stroke="#fff" stroke-opacity=".3"/></g>
<radialGradient id="wgd" cx=".3" cy=".5" r=".8"><stop offset="0" stop-color="#8fb0e0"/><stop offset=".6" stop-color="#dfe6ee"/><stop offset="1" stop-color="#f6eee0"/></radialGradient>
<g id="wp" fill="url(#wgd)" stroke="#8a5a2b" stroke-width="2.5" stroke-linejoin="round"><path d="M100 78C118 34 162 20 186 32C192 62 152 92 100 84Z"/><path d="M100 86C140 90 166 112 150 142C124 156 108 122 100 102Z"/></g></defs></svg>
<div class="stage"><svg class="bf" viewBox="0 0 200 160"><g class="wg"><use href="#wp"/></g><g transform="translate(200 0) scale(-1 1)"><g class="wg"><use href="#wp"/></g></g><ellipse cx="100" cy="92" rx="3.5" ry="24" fill="#5b4326"/><path d="M98 68Q90 50 84 46M102 68Q110 50 116 46" stroke="#5b4326" fill="none"/></svg></div>
<div class="fl b"><svg viewBox="0 0 400 800" preserveAspectRatio="xMidYMid slice"><use href="#fw" transform="translate(110 620) scale(1.6) rotate(15)"/><use href="#fw" transform="translate(300 700) scale(1.3) rotate(-20)"/></svg></div><div class="fl t"><svg viewBox="0 0 400 800" preserveAspectRatio="xMidYMid slice"><use href="#fw" transform="translate(300 90) scale(1.3) rotate(10)"/><use href="#fw" transform="translate(80 60) scale(1) rotate(-10)"/></svg></div><div class="fl l"><svg viewBox="0 0 400 800" preserveAspectRatio="xMidYMid slice"><use href="#fw" transform="translate(60 230) scale(1.7) rotate(-8)"/><use href="#fw" transform="translate(110 600) scale(1.2) rotate(20)"/></svg></div><div class="fl r"><svg viewBox="0 0 400 800" preserveAspectRatio="xMidYMid slice"><use href="#fw" transform="translate(330 200) scale(1.4) rotate(12)"/><use href="#fw" transform="translate(290 560) scale(1.7) rotate(-15)"/></svg></div>
<button class="env" id="env" aria-label="Open the invitation"></button>
<div class="seal">L&amp;M</div>
<div class="cap top"><div class="names-s">Latifa &amp; Moussa</div><div class="sub">Wedding Invitation</div></div>
<div class="cap bot"><div class="hint">Open the invitation</div></div>
</div>

<main id="inv"><article class="sheet">
<section class="rv"><div class="script t1">Wedding<br>Invitation</div>
<p class="ar" dir="rtl" style="margin-top:22px">إلى كل من له في قلبي مكان عزيز<br>بكل ود وحب أدعوكم لحضور حفل زفافي</p>
<svg class="orn" viewBox="0 0 150 16" fill="none" stroke="currentColor"><path d="M0 8H60M90 8H150"/><path d="M75 2c6 4 6 8 0 12-6-4-6-8 0-12zM64 8c5-3 8-3 10 0-2 3-5 3-10 0zM86 8c-5-3-8-3-10 0 2 3 5 3 10 0z"/></svg>
<div class="script names">Latifa<br>&amp; Moussa</div></section>

<section class="rv"><h2>The Countdown Begins</h2>
<div id="cd" class="cd"><div><b id="d">0</b><small>DAYS</small></div><div><b id="h">0</b><small>HOURS</small></div><div><b id="m">0</b><small>MINUTES</small></div><div><b id="s">0</b><small>SECONDS</small></div></div></section>

<section class="rv det">
<div><svg viewBox="0 0 32 32"><rect x="4" y="7" width="24" height="21" rx="2"/><path d="M4 13h24M10 4v6M22 4v6"/></svg><h3>DATE</h3><p>20 June 2026</p></div>
<div><svg viewBox="0 0 32 32"><circle cx="16" cy="16" r="12"/><path d="M16 8v8l5 3"/></svg><h3>TIME</h3><p>20:00</p></div>
<div><svg viewBox="0 0 32 32"><path d="M16 29S6 19 6 12a10 10 0 0120 0c0 7-10 17-10 17z"/><circle cx="16" cy="12" r="3.5"/></svg><h3>VENUE</h3><p>Afrah Tetouan Traiteur et Glacier<br>Tetouan, Morocco</p></div></section>

<section class="rv"><h2>The Venue</h2>
<p style="font-size:22px;color:var(--brown)">Afrah Tetouan Traiteur et Glacier</p><p style="font-size:18px;color:#7a6446">Tetouan, Morocco</p>
<a class="btn" href="https://maps.app.goo.gl/L9cGKVYby12gEPHd6" target="_blank" rel="noopener">OPEN LOCATION</a></section>

<section class="rv" style="margin:0"><div class="en">With Love</div><div class="script names" style="font-size:clamp(44px,14vw,64px)">Latifa &amp; Moussa</div>
<svg class="orn" viewBox="0 0 150 16" fill="none" stroke="currentColor"><path d="M0 8H60M90 8H150"/><path d="M75 2c6 4 6 8 0 12-6-4-6-8 0-12zM64 8c5-3 8-3 10 0-2 3-5 3-10 0zM86 8c-5-3-8-3-10 0 2 3 5 3 10 0z"/></svg>
<p style="font-size:18px;font-style:italic;color:var(--brown)">Thank you for celebrating this special moment with us.</p></section>
</article></main>

<button id="music" aria-label="Music"><span>♪</span></button>
<script>
const $=id=>document.getElementById(id),T=new Date('2026-06-20T20:00:00');
function pad(n){return String(n).padStart(2,'0')}
let last={};
function tick(){const diff=T-new Date();
 if(diff<=0){$('cd').innerHTML='<div class="done" style="grid-column:1/-1;background:none;border:0;box-shadow:none">OUR SPECIAL DAY HAS ARRIVED ♥</div>';clearInterval(iv);return}
 const v={d:Math.floor(diff/864e5),h:Math.floor(diff/36e5)%24,m:Math.floor(diff/6e4)%60,s:Math.floor(diff/1e3)%60};
 for(const k in v){const e=$(k),t=k=='d'?String(v[k]):pad(v[k]);if(last[k]!==t){e.textContent=t;e.classList.remove('tick');void e.offsetWidth;e.classList.add('tick');last[k]=t}}}
const iv=setInterval(tick,1000);tick();
function petals(){for(let i=0;i<16;i++){const p=document.createElement('span');p.className='petal';p.style.left=Math.random()*100+'vw';p.style.setProperty('--dx',(Math.random()*120-60)+'px');p.style.animationDuration=(5+Math.random()*4)+'s';p.style.animationDelay=Math.random()*2.5+'s';document.body.appendChild(p);setTimeout(()=>p.remove(),11000)}}
for(let i=0;i<14;i++){const g=document.createElement('i');g.className='gold';g.style.left=Math.random()*100+'vw';g.style.top=Math.random()*100+'vh';g.style.animationDelay=Math.random()*6+'s';document.body.appendChild(g)}
let opened=false;
$('env').onclick=()=>{if(opened)return;opened=true;$('intro').classList.add('opening');
 setTimeout(petals,4300);
 setTimeout(()=>{$('inv').style.display='block';$('music').style.display='flex';requestAnimationFrame(()=>requestAnimationFrame(()=>$('inv').classList.add('show')));$('intro').classList.add('gone');scrollTo(0,0);watch()},4600)};
function watch(){const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.15});document.querySelectorAll('.rv').forEach(el=>io.observe(el))}
addEventListener('scroll',()=>{const y=scrollY*.08;document.querySelector('.vine.l').style.transform=`translateY(${-y}px)`;document.querySelector('.vine.r').style.transform=`scaleX(-1) translateY(${y}px)`},{passive:true});
// soft piano (Pachelbel's Canon, generated; starts only on tap)
let ac,mg,timer,playing=false,step=0,nt=0;
const M=n=>440*Math.pow(2,(n-69)/12),P=[0,1,2,3,2,1,2,3];
const CH=[[38,[62,66,69,74]],[33,[61,64,69,73]],[35,[62,66,71,74]],[42,[61,66,69,73]],[43,[62,67,71,74]],[38,[62,66,69,74]],[43,[62,67,71,74]],[33,[61,64,69,73]]];
function pn(f,t,v,d){const g=ac.createGain();g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(v,t+.008);g.gain.exponentialRampToValueAtTime(.0001,t+d);g.connect(mg);[[1,1],[2,.35],[3,.12],[4,.05]].forEach(([m,a])=>{const o=ac.createOscillator();o.frequency.value=f*m;const k=ac.createGain();k.gain.value=a;o.connect(k);k.connect(g);o.start(t);o.stop(t+d+.05)})}
function sched(){while(nt<ac.currentTime+2){const[c,ns]=CH[Math.floor(step/8)%CH.length],i=step%8;if(i==0)pn(M(c+12),nt,.22,3);pn(M(ns[P[i]]),nt,.16,2.2);nt+=.6;step++}}
$('music').onclick=()=>{const b=$('music');
 if(!playing){if(!ac){ac=new(window.AudioContext||window.webkitAudioContext)();mg=ac.createGain();const dl=ac.createDelay();dl.delayTime.value=.34;const fb=ac.createGain();fb.gain.value=.3;mg.connect(ac.destination);mg.connect(dl);dl.connect(fb);fb.connect(dl);dl.connect(ac.destination)}
  ac.resume();nt=ac.currentTime+.1;mg.gain.cancelScheduledValues(0);mg.gain.setValueAtTime(0,ac.currentTime);mg.gain.linearRampToValueAtTime(.7,ac.currentTime+1.5);sched();timer=setInterval(sched,500);playing=true;b.classList.add('spin')}
 else{clearInterval(timer);mg.gain.linearRampToValueAtTime(0,ac.currentTime+.8);playing=false;b.classList.remove('spin')}};
</script></body></html>
