<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Latifa & Moussa — Wedding Invitation</title>
<link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Cormorant+Garamond:wght@400;600&family=Amiri:wght@400;700&display=swap" rel="stylesheet">
<style>
:root{--ivory:#efe8db;--cream:#e6dccb;--gold:#b08d57;--bur:#5a1f2b;--brown:#2b1d17;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-padding-top:env(safe-area-inset-top,0px);height:100%}
*{box-sizing:border-box;margin:0}
body{background:var(--cream);color:var(--bur);font-family:'Cormorant Garamond',Georgia,serif;overflow-x:hidden;min-height:100%}
.bg{position:fixed;inset:0;z-index:0;background:linear-gradient(#d9cfbf 0,#e9e1d3 38%,#e4dbcb 100%)}
.bg svg{position:absolute;top:0;left:0;width:100%;height:46%}
.bg .paper{position:absolute;inset:0;opacity:.35;mix-blend-mode:multiply}
.vine{position:absolute;width:60%;max-width:340px;opacity:.5;transition:transform .2s linear}
.vine.l{left:-6%;top:44%}.vine.r{right:-6%;bottom:4%;transform:scaleX(-1)}
/* envelope */
#intro{position:fixed;inset:0;z-index:5;overflow:hidden;perspective:1300px;background:linear-gradient(#efe8db,#d8cfc0 55%,#aaa196);transition:opacity 1.6s ease}
#intro.gone{opacity:0;pointer-events:none}
.stage{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;z-index:0}
.bf{width:min(62vw,320px);opacity:0;filter:drop-shadow(8px 12px 10px rgba(60,45,30,.3))}
.wg{transform-origin:100px 80px;animation:flap .9s ease-in-out infinite alternate}
@keyframes flap{to{transform:scaleX(.5)}}
.opening .bf{animation:fly 3.2s ease-in-out 1.6s forwards}
@keyframes fly{0%{opacity:0;transform:scale(.6)}25%{opacity:1;transform:scale(1)}70%{opacity:1;transform:scale(1) translateY(-4vh)}100%{opacity:0;transform:scale(.8) translateY(-45vh)}}
.env{position:absolute;inset:0;z-index:2;border:0;background:none;cursor:pointer;padding:0;-webkit-tap-highlight-color:transparent}
.fl{position:absolute;inset:0;transition:transform 2s cubic-bezier(.55,0,.25,1),opacity .6s ease 1.7s;will-change:transform}
.fl svg{position:absolute;inset:0;width:100%;height:100%}
.fl.t{clip-path:polygon(0 0,100% 0,50% 50%);background:linear-gradient(#8aa2bd,#7189a6);transform-origin:50% 0;z-index:2;transition-delay:.8s,1.9s}
.fl.b{clip-path:polygon(0 100%,100% 100%,50% 50%);background:linear-gradient(#5b7390,#4d647f);transform-origin:50% 100%;z-index:1;transition-delay:.9s,2s}
.fl.l{clip-path:polygon(0 0,50% 50%,0 100%);background:linear-gradient(90deg,#7b93ae,#6b83a0);transform-origin:0 50%;z-index:3;transition-delay:.3s,1.4s}
.fl.r{clip-path:polygon(100% 0,100% 100%,50% 50%);background:linear-gradient(270deg,#7890ab,#6a829f);transform-origin:100% 50%;z-index:3;transition-delay:.35s,1.4s}
.opening .fl{opacity:0}.opening .l{transform:rotateY(-115deg)}.opening .r{transform:rotateY(115deg)}.opening .t{transform:rotateX(115deg)}.opening .b{transform:rotateX(-115deg)}
.cap{position:absolute;left:0;right:0;z-index:6;text-align:center;pointer-events:none;color:#efe8db;transition:opacity .8s}
.cap.top{top:calc(9vh + env(safe-area-inset-top,0px))}.cap.bot{bottom:calc(9vh + env(safe-area-inset-bottom,0px))}
.opening .cap{opacity:0}
.names-s{font-family:'Great Vibes';font-size:clamp(34px,10vw,48px)}
.sub{letter-spacing:.35em;font-size:13px;text-transform:uppercase;margin-top:6px}
.hint{font-size:17px;font-style:italic;animation:fade 2.5s ease-in-out infinite}
@keyframes fade{50%{opacity:.35}}
.seal{position:absolute;left:50%;top:50%;width:clamp(80px,24vw,112px);aspect-ratio:1;translate:-50% -50%;border-radius:50%;z-index:6;pointer-events:none;background:radial-gradient(circle at 35% 30%,#b3505f,#6d2230 55%,#3f1119);box-shadow:0 4px 12px rgba(0,0,0,.45),inset 0 0 0 4px rgba(255,255,255,.08),inset 0 0 0 8px rgba(0,0,0,.15);display:flex;align-items:center;justify-content:center;color:#e4c98f;font-family:'Great Vibes';font-size:clamp(24px,7vw,34px);transition:transform 1s ease,opacity .8s ease .3s}
.opening .seal{transform:translateY(14px) rotate(-14deg) scale(.9);opacity:0}
/* card */
#inv{position:relative;z-index:2;display:none;opacity:0;transition:opacity 2s ease;padding:18px 14px 90px}
#inv.show{opacity:1}
.sheet{position:relative;max-width:460px;margin:0 auto;padding:44px 24px 40px;background:linear-gradient(#efe8db,#e9e0d0);box-shadow:0 20px 50px rgba(60,40,20,.28);text-align:center;outline:1px solid var(--gold);outline-offset:-10px}
.sheet::before{content:"";position:absolute;inset:14px;border:1px solid rgba(176,141,87,.5);pointer-events:none}
.sheet>section{margin-bottom:38px}
.rv{opacity:0;transform:translateY(14px);transition:opacity 1.4s ease,transform 1.4s ease}.rv.in{opacity:1;transform:none}
.script{font-family:'Great Vibes',cursive;color:var(--bur);line-height:1.05}
.t1{font-size:clamp(36px,11vw,50px)}
.ar{font-family:'Amiri',serif;font-size:clamp(20px,5.6vw,25px);line-height:2;color:var(--brown)}
.en{font-size:15px;letter-spacing:.14em;text-transform:uppercase;line-height:1.8;color:var(--brown)}
.names{font-size:clamp(52px,17vw,78px);margin:6px 0}
.orn{display:block;margin:16px auto;width:150px;color:var(--gold)}
h2{font-weight:600;letter-spacing:.28em;font-size:15px;text-transform:uppercase;margin-bottom:18px}
.cd{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.cd div{background:var(--ivory);border:1px solid var(--gold);padding:14px 2px 10px;box-shadow:0 4px 12px rgba(60,40,20,.15);position:relative}
.cd div::before{content:"";position:absolute;inset:3px;border:1px solid rgba(176,141,87,.35)}
.cd b{display:block;font-size:clamp(28px,9vw,40px);font-weight:600;color:var(--bur)}
.cd b.tick{animation:tk .6s ease}@keyframes tk{from{opacity:.2;transform:translateY(-6px)}}
.cd small{font-size:11px;letter-spacing:.18em;color:#7a6446}
.done{font-size:22px;letter-spacing:.12em;padding:20px 0;color:var(--bur)}
.det{display:grid;gap:22px}
.det svg{width:34px;height:34px;stroke:var(--gold);fill:none;stroke-width:1.1}
.det p{font-size:20px;color:var(--brown)}.det h3{font-size:12px;letter-spacing:.3em;font-weight:400;margin:6px 0 4px}
.btn{display:inline-block;margin-top:18px;padding:15px 30px;border:1px solid var(--gold);color:#f3e9d4;background:var(--bur);text-decoration:none;letter-spacing:.25em;font-size:13px;transition:all .5s ease;box-shadow:0 0 0 3px var(--ivory),0 0 0 4px var(--gold)}
.btn:hover{background:#3f1119;letter-spacing:.3em}
#music{position:fixed;z-index:9;right:16px;bottom:calc(16px + env(safe-area-inset-bottom,0px));width:50px;height:50px;border-radius:50%;border:1.5px solid var(--gold);background:rgba(239,232,219,.92);color:var(--bur);display:none;align-items:center;justify-content:center;font-size:20px;cursor:pointer}
#music.spin span{animation:rot 6s linear infinite;display:block}@keyframes rot{to{rotate:360deg}}
.petal{position:fixed;top:-20px;z-index:8;width:12px;height:16px;border-radius:80% 0 80% 0;background:linear-gradient(135deg,#f1e2d0,#d9b9a0);opacity:.8;pointer-events:none;animation:fall linear forwards}
@keyframes fall{to{transform:translate(var(--dx),110vh) rotate(540deg);opacity:.2}}
.gold{position:fixed;z-index:1;width:3px;height:3px;border-radius:50%;background:#c9a565;opacity:0;animation:tw 6s ease-in-out infinite}
@keyframes tw{50%{opacity:.7;transform:translateY(-16px)}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition-duration:.01s!important}}
@media(min-width:700px){.sheet{padding:60px 50px}}
</style></head><body>
<div class="bg">
<svg viewBox="0 0 400 210" preserveAspectRatio="xMidYMin slice"><defs><linearGradient id="g" x1="0" x2="1"><stop offset="0" stop-color="#cfc3b0"/><stop offset=".5" stop-color="#f1eadf"/><stop offset="1" stop-color="#cbbfab"/></linearGradient></defs>
<g fill="none" stroke="#bfb29b" stroke-width="1.2"><path d="M0 210Q40 60 200 8Q360 60 400 210" fill="url(#g)" opacity=".7"/><path d="M0 210Q60 90 200 40Q340 90 400 210" opacity=".8"/><path d="M-20 210Q60 120 200 78Q340 120 420 210" fill="#f0e9dc" opacity=".6"/><path d="M200 8V70M110 30Q150 60 200 70Q250 60 290 30"/><circle cx="200" cy="52" r="16" fill="#efe8db"/></g></svg>
<svg class="paper" width="100%" height="100%"><filter id="n"><feTurbulence type="fractalNoise" baseFrequency=".9" numOctaves="2"/><feColorMatrix values="0 0 0 0 .5 0 0 0 0 .45 0 0 0 0 .38 0 0 0 .5 0"/></filter><rect width="100%" height="100%" filter="url(#n)"/></svg>
