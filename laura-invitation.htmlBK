<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>LAURA Produits Beauté — حفل افتتاح</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#fbf3ec;--card:#fffaf5;--ink:#241a15;--muted:#7b6659;--gold:#b98a52;--gold2:#d9b27c;--line:rgba(185,138,82,.35);
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#17120f;--card:#221b16;--ink:#f6ebe0;--muted:#b9a392;--line:rgba(217,178,124,.35)}}
:root[data-theme="dark"]{--bg:#17120f;--card:#221b16;--ink:#f6ebe0;--muted:#b9a392;--line:rgba(217,178,124,.35)}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:'Tajawal',system-ui,sans-serif;line-height:1.8;overflow-x:hidden}
.serif{font-family:'Cormorant Garamond',Georgia,serif}
.wrap{max-width:560px;margin:0 auto;padding:0 22px}
section{padding:54px 0;text-align:center}
.eyebrow{font-family:'Cormorant Garamond',Georgia,serif;letter-spacing:.28em;text-transform:uppercase;font-size:13px;color:var(--gold)}
h1,h2{margin:.2em 0;font-weight:700}
h2{font-size:34px}
.divider{width:64px;height:2px;margin:14px auto 22px;background:linear-gradient(90deg,transparent,var(--gold),transparent)}
/* hero */
.hero{padding-top:34px;position:relative}
.hero .logo{width:min(78vw,300px);height:auto;border-radius:50%;box-shadow:0 18px 50px rgba(185,138,82,.35),0 0 0 6px var(--card),0 0 0 7px var(--line);animation:float 6s ease-in-out infinite}
@keyframes float{50%{transform:translateY(-8px)}}
.hero h1{font-family:'Cormorant Garamond',Georgia,serif;font-size:44px;letter-spacing:.06em;margin-top:30px;direction:ltr}
.hero .tag{font-style:italic;font-family:'Cormorant Garamond',Georgia,serif;font-size:21px;color:var(--gold);direction:ltr}
.facts{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:30px}
.fact{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:14px 6px}
.fact small{display:block;color:var(--muted);font-size:12px;letter-spacing:.12em;text-transform:uppercase}
.fact b{display:block;font-size:15px;margin-top:2px}
/* marquee */
.marquee{overflow:hidden;white-space:nowrap;background:var(--ink);color:var(--bg);padding:10px 0;direction:ltr;font-family:'Cormorant Garamond',Georgia,serif;font-style:italic;font-size:18px}
.marquee div{display:inline-block;animation:mq 28s linear infinite;padding-left:100%}
@keyframes mq{to{transform:translateX(-100%)}}
/* about */
.about p{margin:.5em 0;font-size:18px}
.about .lead{font-size:24px;font-weight:700;color:var(--gold)}
.collage{width:100%;height:auto;border-radius:22px;border:1px solid var(--line);box-shadow:0 14px 40px rgba(0,0,0,.12);display:block;margin-top:28px}
.chips{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:22px}
.chip{border:1px solid var(--line);background:var(--card);border-radius:999px;padding:6px 16px;font-size:14px}
/* timeline */
.tl{list-style:none;margin:30px 0 0;padding:0;text-align:right;position:relative}
.tl:before{content:"";position:absolute;right:27px;top:8px;bottom:8px;width:2px;background:var(--line)}
.tl li{position:relative;padding:0 76px 26px 0;min-height:56px}
.tl .n{position:absolute;right:0;top:0;width:56px;height:56px;border-radius:50%;background:var(--card);border:1.5px solid var(--gold);display:grid;place-items:center;font-family:'Cormorant Garamond',Georgia,serif;font-size:22px;color:var(--gold)}
.tl .t{font-weight:700;font-size:20px;direction:ltr;text-align:right;color:var(--gold)}
.tl .d{font-size:17px}
/* map */
.map{margin-top:24px;background:var(--card);border:1px solid var(--line);border-radius:22px;overflow:hidden}
.map svg{display:block;width:100%;height:auto}
.map .in{padding:18px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;cursor:pointer;text-decoration:none;font:700 17px 'Tajawal',sans-serif;padding:13px 26px;border-radius:999px;background:linear-gradient(135deg,var(--gold),var(--gold2));color:#2a1c10;box-shadow:0 8px 22px rgba(185,138,82,.35)}
.btn.wa{background:#25D366;color:#06260f;box-shadow:0 8px 22px rgba(37,211,102,.3)}
.btn.ghost{background:transparent;border:1.5px solid var(--gold);color:var(--gold);box-shadow:none}
/* rsvp */
form{text-align:right;margin-top:20px;background:var(--card);border:1px solid var(--line);border-radius:22px;padding:22px}
label{display:block;font-weight:700;margin:14px 0 6px;font-size:15px}
input[type=text],input[type=number],textarea{width:100%;font:inherit;color:var(--ink);background:var(--bg);border:1px solid var(--line);border-radius:12px;padding:11px 14px}
.yn{display:flex;gap:10px}
.yn label{flex:1;margin:0;font-weight:500}
.yn input{display:none}
.yn span{display:block;text-align:center;padding:11px;border:1.5px solid var(--line);border-radius:12px;cursor:pointer}
.yn input:checked+span{background:var(--gold);border-color:var(--gold);color:#2a1c10;font-weight:700}
.rsvp-sub{color:var(--muted);font-size:15px}
.promo{margin-top:20px;border-radius:18px;padding:16px 18px;background:linear-gradient(135deg,var(--gold),var(--gold2));color:#2a1c10;box-shadow:0 8px 22px rgba(185,138,82,.35)}
.promo b{display:block;font-size:22px}
.promo span{font-size:14px}
.ig{background:var(--card);border:1px solid var(--line);border-radius:22px;padding:28px 20px}
.btn.igb{background:linear-gradient(135deg,#f58529,#dd2a7b 50%,#8134af);color:#fff;box-shadow:0 8px 22px rgba(221,42,123,.3)}
.music{position:fixed;left:16px;bottom:calc(16px + env(safe-area-inset-bottom,0px));z-index:20;padding:11px 18px;font-size:15px}
footer{padding:30px 0 50px;text-align:center;color:var(--muted);font-size:14px}
.reveal{opacity:0;transform:translateY(18px);transition:.8s}
.reveal.on{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){.hero .logo,.marquee div{animation:none}.reveal{opacity:1;transform:none}}
</style>
</head>
<body>

<header class="hero">
  <div class="wrap">
    <div class="eyebrow">A new door opens in Tétouan</div>
    <div style="height:18px"></div>
    <img class="logo" src="data:image/webp;base64," alt="Logo LAURA Produits Beauté">
    <h1>LAURA</h1>
    <div class="eyebrow" style="margin-top:-2px">Produits Beauté</div>
    <div class="tag">Tout pour vos cheveux</div>
    <div class="facts">
      <div class="fact"><small>Date</small><b>1 Novembre 2026</b></div>
      <div class="fact"><small>Jour</small><b>الأحد</b></div>
      <div class="fact"><small>Lieu</small><b>Tétouan</b></div>
    </div>
  </div>
</header>

<div class="marquee" aria-hidden="true"><div>A new door opens in Tétouan — November 1, 2026 · A new door opens in Tétouan — November 1, 2026 · A new door opens in Tétouan — November 1, 2026 · A new door opens in Tétouan — November 1, 2026 ·</div></div>

<section class="about" id="about">
  <div class="wrap reveal">
    <div class="eyebrow">About</div>
    <h2>حفل افتتاح</h2>
    <div class="divider"></div>
    <p class="lead">تشاركوني فرحة الافتتاح</p>
    <p>الأحلام جميلة والجميل أن تكون واقعاً</p>
    <p>والأجمل أن نشاركها مع من نحب</p>
    <p>ها أنا اليوم أبدأ رحلة جديدة أخطو فيها خطواتي الأولى نحو تحقيق حلمي الكبير</p>
    <p>ولأنكم جزء من خطواتي الأولى يسعدني أن تكونوا معي</p>
    <img class="collage" src="data:image/webp;base64," alt="Nos produits : Lizze Extreme, DSP, Hot Air Styler, offres -20%">
    <div class="chips"><span class="chip">Séchoir</span><span class="chip">Lisseur</span><span class="chip">Boucleur</span><span class="chip">Brosse</span></div>
    <div class="promo"><b>عروض وتخفيضات تصل إلى 20%</b><span>لجميع زوار حفل الافتتاح · Offres &amp; réductions -20%</span></div>
  </div>
</section>

<section id="program">
  <div class="wrap reveal">
    <div class="eyebrow">The three moments</div>
    <h2 class="serif" style="direction:ltr">When &amp; Where</h2>
    <div class="divider"></div>
    <ul class="tl">
      <li><span class="n">01</span><div class="t">11:00</div><div class="d">الافتتاح وقص الشريط</div></li>
      <li><span class="n">02</span><div class="t">12:00</div><div class="d">اكتشاف المنتجات - Séchoir, Lisseur, Boucleur</div></li>
      <li><span class="n">03</span><div class="t">15:00</div><div class="d">هدايا وعروض حصرية للزوار</div></li>
      <li><span class="n">04</span><div class="t">23:00</div><div class="d">اختتام الحفل - Merci</div></li>
    </ul>
  </div>
</section>

<section id="map">
  <div class="wrap reveal">
    <div class="eyebrow">Getting there</div>
    <h2>الموقع على Google Maps</h2>
    <div class="divider"></div>
    <div class="map">
      <svg viewBox="0 0 560 260" role="img" aria-label="Carte stylisée du lieu">
        <rect width="560" height="260" fill="#efe3d6"/>
        <g stroke="#fffaf5" stroke-width="10" fill="none" stroke-linecap="round"><path d="M-10 190 C120 150 220 220 330 150 S500 90 580 120"/><path d="M130 -10 L190 270"/><path d="M380 -10 C360 80 420 160 400 270"/><path d="M-10 80 L580 40" stroke-width="6"/></g>
        <g fill="#e2d1bd"><rect x="215" y="170" width="60" height="40" rx="8"/><rect x="40" y="110" width="70" height="50" rx="8"/><rect x="430" y="170" width="90" height="60" rx="8"/><rect x="250" y="55" width="80" height="45" rx="8"/></g>
        <g transform="translate(280 112)"><ellipse cx="0" cy="62" rx="22" ry="7" fill="rgba(0,0,0,.18)"/><path d="M0 60 C-30 22 -32 4 -32 -8 A32 32 0 1 1 32 -8 C32 4 30 22 0 60Z" fill="#b98a52"/><circle cx="0" cy="-8" r="12" fill="#fffaf5"/></g>
      </svg>
      <div class="in">
        <div class="serif" style="font-size:22px;direction:ltr"><b>HJCF+45H Tétouan, Morocco</b></div>
        <p style="margin:4px 0 14px;color:var(--muted)">اضغط للحصول على الاتجاهات</p>
        <a class="btn" href="https://www.google.com/maps/dir/?api=1&destination=35.5703125%2C-5.3770156" target="_blank" rel="noopener">📍 Get directions</a>
      </div>
    </div>
  </div>
</section>

<section id="rsvp">
  <div class="wrap reveal">
    <div class="eyebrow">We'd love to have you</div>
    <h2 class="serif" style="direction:ltr">RSVP</h2>
    <div class="divider"></div>
    <p class="rsvp-sub">Please reply by December 27, 2026.<br>تأكيد الحضور يصلني مباشرة على واتساب</p>
    <form id="f" onsubmit="return false">
      <label for="name">Name · الاسم</label>
      <input id="name" type="text" autocomplete="name">
      <label>Will we have you with us at the event?</label>
      <div class="yn">
        <label><input type="radio" name="att" value="yes" checked><span>Yes · نعم</span></label>
        <label><input type="radio" name="att" value="no"><span>No · لا</span></label>
      </div>
      <label for="g">Additional Guests · عدد المرافقين</label>
      <input id="g" type="number" min="0" max="10" value="0" inputmode="numeric">
      <label for="msg">Message for host · رسالة</label>
      <textarea id="msg" rows="3"></textarea>
      <div style="text-align:center;margin-top:20px"><a id="send" class="btn wa" href="#" target="_blank" rel="noopener">إرسال عبر واتساب</a></div>
    </form>
    <p style="margin-top:22px"><a class="btn ghost" href="https://wa.me/212724743483" target="_blank" rel="noopener">+212 724-743483</a></p>
  </div>
</section>

<section id="insta" style="padding-top:0">
  <div class="wrap reveal">
    <div class="ig">
      <div class="eyebrow">Instagram</div>
      <h2 style="font-size:28px">تابعونا على إنستغرام</h2>
      <p style="margin:0 0 6px">اكتشفوا جديد المنتجات والعروض، وادعوا صديقاتكم لمتابعة الصفحة 💛</p>
      <p class="serif" style="font-size:24px;color:var(--gold);margin:6px 0 16px;direction:ltr"><b>@lati.aura</b></p>
      <a class="btn igb" href="https://www.instagram.com/lati.aura" target="_blank" rel="noopener">📸 Suivez-nous · تابعنا</a>
    </div>
  </div>
</section>

<button class="btn music" id="mus" type="button">🎵 الموسيقى</button>
<audio id="aud" loop preload="auto" src="data:audio/mpeg;base64,"></audio>

<footer><div class="serif" style="font-size:20px;color:var(--gold)">LAURA · Produits Beauté</div>Tout pour vos cheveux · <a href="https://www.instagram.com/lati.aura" target="_blank" rel="noopener" style="color:var(--gold)">@lati.aura</a></footer>

<script>
(function(){
  var NUM='212724743483';
  var send=document.getElementById('send');
  function upd(){
    var n=document.getElementById('name').value.trim();
    var att=document.querySelector('input[name=att]:checked').value==='yes'?'سأحضر ✅':'للأسف لن أستطيع الحضور';
    var g=document.getElementById('g').value||'0';
    var m=document.getElementById('msg').value.trim();
    var t='مرحبا، بخصوص حفل افتتاح LAURA Produits Beauté (1 نونبر 2026)\n'+'الاسم: '+n+'\n'+att+'\nعدد المرافقين: '+g+(m?'\nرسالة: '+m:'');
    send.href='https://wa.me/'+NUM+'?text='+encodeURIComponent(t);
  }
  document.getElementById('f').addEventListener('input',upd);upd();
  var aud=document.getElementById('aud'),mus=document.getElementById('mus'),playing=false,auto=true;
  function setUI(){mus.textContent=playing?'\u23f8 \u0627\u0644\u0645\u0648\u0633\u064a\u0642\u0649':'\ud83c\udfb5 \u0627\u0644\u0645\u0648\u0633\u064a\u0642\u0649';}
  function play(){var p=aud.play();if(p&&p.then){p.then(function(){playing=true;auto=false;setUI();}).catch(function(){playing=false;setUI();});}else{playing=true;setUI();}}
  function stop(){aud.pause();playing=false;setUI();}
  mus.addEventListener('click',function(e){e.stopPropagation();auto=false;playing?stop():play();});
  function first(){if(auto&&!playing)play();}
  ['click','touchend','keydown'].forEach(function(ev){document.addEventListener(ev,first,{passive:true});});
  var io=('IntersectionObserver' in window)?new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('on');io.unobserve(e.target)}})},{threshold:.12}):null;
  document.querySelectorAll('.reveal').forEach(function(el){io?io.observe(el):el.classList.add('on')});
})();
</script>
</body>
</html>
